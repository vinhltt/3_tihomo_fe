# Normalize line endings across platforms: LF in repo and in working tree
* text=auto eol=lf

# Windows-only scripts must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix scripts / container files must keep LF
*.sh text eol=lf
Dockerfile* text eol=lf
.dockerignore text eol=lf

# Lockfiles
package-lock.json -diff linguist-generated

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
