# Nuxt Configuration Environment Variables
# Copy this file to .env.local and update values for your environment

# Identity API Configuration - New Simplified API
API_BASE_URL=http://localhost:5214

# Social Login Configuration
APP_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id-here
NUXT_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id-here

# Application Base URL (for returnUrl construction)  
NUXT_PUBLIC_APP_BASE=http://localhost:3500

# Production Example:
# API_BASE_URL=https://identity-api.yourdomain.com
# APP_PUBLIC_GOOGLE_CLIENT_ID=production-google-client-id
# NUXT_PUBLIC_FACEBOOK_APP_ID=production-facebook-app-id
# NUXT_PUBLIC_APP_BASE=https://app.yourdomain.com

# Staging Example:
# API_BASE_URL=https://identity-api-staging.yourdomain.com
# APP_PUBLIC_GOOGLE_CLIENT_ID=staging-google-client-id
# NUXT_PUBLIC_FACEBOOK_APP_ID=staging-facebook-app-id
# NUXT_PUBLIC_APP_BASE=https://app-staging.yourdomain.com

# Legacy SSO Configuration (deprecated, will be removed)
# NUXT_PUBLIC_SSO_BASE=http://localhost:5217
# NUXT_PUBLIC_SSO_CLIENT_ID=nuxt-spa-client
# NUXT_PUBLIC_SSO_REDIRECT_URI=http://localhost:3500/auth/sso/callback
# NUXT_PUBLIC_SSO_LOGOUT_REDIRECT_URI=http://localhost:3500/auth/sso/logout
